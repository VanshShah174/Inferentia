# =============================================================================
# Platform inputs — EXAMPLE (copy to terraform.tfvars and adjust)
# =============================================================================
# Real terraform.tfvars is gitignored (best practice: never commit tfvars, so a
# future secret can't slip in). This .example is the committed template showing
# exactly what to set. None of these values are secrets — account id is derived
# at runtime via aws_caller_identity.
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   # edit if needed, then: terraform plan / apply
# =============================================================================
project = "inferentia"
region  = "ca-central-1"

vpc_cidr = "10.0.0.0/16"
az_count = 2

kubernetes_version = "1.32"
node_instance_type = "t3.large"
node_min           = 1
node_desired       = 2
node_max           = 3

# Demo/portfolio: allow teardown of the model bucket. Set false for a real prod.
model_bucket_force_destroy = true

inference_namespaces  = ["inference-dev", "inference-qa", "inference-ppd", "inference-prod"]
model_service_account = "vllm-model-loader"
